# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox

# Frontend (exposed to browser via Vite — safe because it is public)
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Url of the product lable (PNG file) that is used by Sharp library to overlay on the generated image.  This should be public URL of the image stored in Supabase Storage bucket.
LABEL_ASSET_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/assets/labels
